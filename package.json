{
  "name": "@nonagenticai/n8n-nodes-artifacts",
  "version": "0.2.3",
  "description": "n8n community node for the Artifact Service API \u2014 multi-tenant artifact storage, manifests and retrieval",
  "keywords": [
    "n8n-community-node-package",
    "n8n-node",
    "artifacts"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/nonagenticai/n8n-nodes-artifacts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint \"nodes/**/*.ts\" \"credentials/**/*.ts\"",
    "lintfix": "eslint \"nodes/**/*.ts\" \"credentials/**/*.ts\" --fix",
    "test": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest",
    "test:watch": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --watch",
    "test:coverage": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage' jest --coverage",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "replaySafe": false,
    "credentials": [
      "dist/credentials/ArtifactsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Artifacts/Artifacts.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "axios": "^1.13.2",
    "eslint": "^10.0.0",
    "gulp": "^5.0.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "n8n-workflow": "^1.120.7",
    "orval": "8.47.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "form-data": "^4.0.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "overrides": {
    "form-data": "^4.0.5",
    "jest-mock": "30.4.1",
    "isolated-vm": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonagenticai/n8n-nodes-artifacts.git"
  },
  "bugs": {
    "url": "https://github.com/nonagenticai/n8n-nodes-artifacts/issues"
  }
}
